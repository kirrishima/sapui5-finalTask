<mvc:View controllerName="library.catalog.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:semantic="sap.f.semantic">
    <semantic:SemanticPage id="page">
        <semantic:titleHeading>
            <Title text="{i18n>mainTitle}" />
        </semantic:titleHeading>
        <semantic:content>
            <List id="booksTable"
                items="{
                    path: 'LibraryODataV2Model>/Books', 
                    sorter: { path: 'ID' },
                    parameters: {
                        expand: 'Author,Category',
                        select: 'ID,Title,Description,PublishDate,PageCount,Rating,Price,Available,Author/Name,Category/Name'
                    }
                }">
                <headerToolbar>
                    <Toolbar>
                        <content>
                            <ComboBox
                                id="authorFilterComboBox"
                                placeholder="{i18n>filterByAuthorPlaceholder}"
                                showClearIcon="true"
                                items="{
                                    path: 'LibraryODataV2Model>/Authors',
                                    sorter: { path: 'Name' },
                                    parameters: {select: 'ID,Name'}
                                }"
                                selectionChange="onAuthorFilterChange">
                                <core:Item key="{LibraryODataV2Model>ID}"
                                    text="{LibraryODataV2Model>Name}" />
                            </ComboBox>
                            <ToolbarSpacer></ToolbarSpacer>
                            <Button text="{i18n>odataV2BookDialogTitleCreate}" type="Accept"
                                press=".onCreateNewBook"></Button>
                        </content>
                    </Toolbar>
                </headerToolbar>
                <items>
                    <ObjectListItem type="Navigation" press=".onNavToDetails"
                        title="{LibraryODataV2Model>Title}" number="{LibraryODataV2Model>Price}"
                        numberUnit="{i18n>bookPriceColumnTitle}">
                        <attributes>
                            <ObjectAttribute title="{i18n>bookIdColumnTitle}"
                                text="{LibraryODataV2Model>ID}" />
                            <ObjectAttribute title="{i18n>bookAuthorColumnTitle}"
                                text="{LibraryODataV2Model>Author/Name}" />
                            <ObjectAttribute title="{i18n>bookCategoryColumnTitle}"
                                text="{LibraryODataV2Model>Category/Name}" />
                            <ObjectAttribute title="{i18n>bookPublishDateColumnTitle}"
                                text="{
                                    path: 'LibraryODataV2Model>PublishDate',
                                    type: 'sap.ui.model.type.Date',
                                    formatOptions: { style: 'medium' }
                                }" />
                        </attributes>
                        <firstStatus>
                            <ObjectStatus title="{i18n>bookAvailableColumnTitle}"
                                text="{= ${LibraryODataV2Model>Available} ? ${i18n>bookAvailableYes} : ${i18n>bookAvailableNo}}"
                                state="{= ${LibraryODataV2Model>Available} ? 'Success' : 'Error'}" />
                        </firstStatus>
                        <secondStatus>
                            <ObjectStatus title="{i18n>bookRatingColumnTitle}"
                                text="{LibraryODataV2Model>Rating}" />
                        </secondStatus>
                    </ObjectListItem>
                </items>
            </List>
        </semantic:content>
    </semantic:SemanticPage>
</mvc:View>